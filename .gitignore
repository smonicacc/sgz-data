# ---------------------------------------------------------------------------
# Generic (Python / IDE / OS) — applies to both private + public repos.
# ---------------------------------------------------------------------------

# Python bytecode + caches
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Project-specific — see README for the two-repo architecture.
#   - Private repo runs fetch_user_posts_private.yaml (full cURL workflow).
#   - Public repo only receives data/ PRs; never executes the curl replay.
# Below rules must match on BOTH repos so behaviour stays consistent.
# ---------------------------------------------------------------------------

# Auto-generated by `fetch_user_posts.py generate --write-run-script`.
# Local convenience only; the workflow re-emits as needed.
captured/run_pages.sh

# Per-run captured cURLs contain long-lived but eventually-expiring Douyin
# session cookies. We gitignore them by default so `git add -A` from the IDE
# never silently leaks a stale token into a commit. The private-repo
# operator must commit them explicitly with `git add -f` (see
# .github/workflows/fetch_user_posts_private.yaml for the full flow).
captured/curl_p*.sh

# Raw API responses regenerated by every `fetch_user_posts.py run`. These
# are transient inputs to the parse step and never need to be checked in.
responses/

# Snapshot output of `fetch_user_posts.py parse`. Authoritative state lives
# in user_posts_history.json (tracked). The snapshot is regenerated each
# run and pushed to Grafana, but not committed.
data/user_posts.json
